[Unit]
Description=Towncrier MeshCore scheduler
After=network.target
[Service]
Type=simple
User=towncrier
WorkingDirectory=/opt/towncrier
ExecStart=/opt/towncrier/.venv/bin/towncrier --db /var/lib/towncrier/towncrier.db --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
